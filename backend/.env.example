# Free LLM access via Groq: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase project (Project Settings -> API). The service role key is secret -
# keep it on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama-cloud fallback (OpenAI-compatible). Used when Groq returns 429/5xx.
FALLBACK_BASE_URL=https://api.ollama.ai/v1
FALLBACK_API_KEY=your-ollama-api-key
FALLBACK_MODEL=llama3.3:70b

# Azure OpenAI — evaluation only (evaluate_session, _self_critique,
# evaluate_diagram). Everything else stays on Groq above.
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Wall-clock cap on a single interview, measured from session start and
# unaffected by activity. The turn limit caps how much is said and the idle
# timeout only measures gaps, so without this a candidate answering every
# 29 minutes could keep a session open for most of a day.
MAX_SESSION_DURATION_MINUTES=120

# Token budget for the transcript sent to evaluation. Sized by the daily
# token quota rather than the context window: llama-3.3-70b accepts 128k
# tokens, but spending 55k of a 100k daily allowance on one evaluation is a
# failure even when it technically fits. Over budget, superseded code/diagram
# revisions are dropped; still over, the transcript is evaluated in chunks.
EVAL_MAX_TRANSCRIPT_TOKENS=12000

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Code execution (backend/services/piston.py). Public Judge0 needs no key and
# is tried first; the RapidAPI Judge0 key is optional but recommended as a
# second attempt since the public instance has no uptime SLA. Sign up free at
# https://rapidapi.com/judge0-official/api/judge0-ce (no card required).
# If both are unavailable, Python/Node/C++ fall back to running directly in
# this container (see _local_subprocess in piston.py); Java has no fallback.
JUDGE0_PUBLIC_URL=https://ce.judge0.com
JUDGE0_RAPIDAPI_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=your-rapidapi-key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Second LLM pass that reviews/corrects the draft evaluation before it's
# persisted. Safe to disable (falls back to the single-pass score) if it
# adds unwanted latency or cost.
EVAL_SELF_CRITIQUE_ENABLED=true

# In-process cache for repeated LLM calls (services/llm_cache.py). The big
# win is the test-case generator, which previously re-ran on every "Run tests"
# click for the same problem. Set to false to force every call through to the
# model (e.g. when measuring uncached cost). Counters are exposed at
# GET /api/analytics/llm-cache.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
LLM_CACHE_MAX_ENTRIES=512

# Distinct opening greetings kept per (track, role) before they're served
# from cache instead of generated. Higher = more variety, more tokens.
LLM_OPENING_POOL_SIZE=5
